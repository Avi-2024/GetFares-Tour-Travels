{
  "info": {
    "name": "GetFares CRM - Webhooks",
    "description": "Webhook endpoints for Meta/Website/WhatsApp lead capture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "campaignId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Meta Lead Capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/meta-leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "meta-leads"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Amit Kumar\",\n  \"phone\": \"+91-9876543210\",\n  \"email\": \"amit.kumar@example.com\",\n  \"budget\": 150000,\n  \"travelDate\": \"2026-05-15\",\n  \"utmSource\": \"facebook\",\n  \"utmMedium\": \"cpc\",\n  \"utmCampaign\": \"summer_bali_2026\",\n  \"campaignId\": \"{{campaignId}}\",\n  \"source\": \"Meta Ads\"\n}"
            },
            "description": "Capture a lead from Meta Ads webhook payload."
          }
        },
        {
          "name": "Website Enquiry Capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/website-enquiry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "website-enquiry"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Neha Sharma\",\n  \"phone\": \"+91-9876543221\",\n  \"email\": \"neha.sharma@example.com\",\n  \"budget\": 250000,\n  \"travelDate\": \"2026-06-10\",\n  \"utmSource\": \"website\",\n  \"utmMedium\": \"form\",\n  \"utmCampaign\": \"honeymoon_special\",\n  \"source\": \"Website\"\n}"
            },
            "description": "Capture a lead from website enquiry form."
          }
        },
        {
          "name": "WhatsApp Enquiry Capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/whatsapp-enquiry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "whatsapp-enquiry"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rohan Gupta\",\n  \"phone\": \"+91-9876543226\",\n  \"email\": \"rohan.gupta@example.com\",\n  \"budget\": 90000,\n  \"travelDate\": \"2026-07-15\",\n  \"utmSource\": \"whatsapp\",\n  \"utmMedium\": \"chat\",\n  \"utmCampaign\": \"domestic_holiday\",\n  \"source\": \"WhatsApp\"\n}"
            },
            "description": "Capture a lead from WhatsApp enquiry."
          }
        }
      ]
    },
    {
      "name": "WhatsApp Webhook",
      "item": [
        {
          "name": "Verify WhatsApp Webhook",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/webhook/whatsapp?hub.mode=subscribe&hub.verify_token={{whatsappVerifyToken}}&hub.challenge=12345",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "whatsapp"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{whatsappVerifyToken}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "12345"
                }
              ]
            }
          }
        },
        {
          "name": "Receive WhatsApp Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"changes\": [\n        {\n          \"value\": {\n            \"messages\": [\n              {\n                \"from\": \"919876543210\",\n                \"id\": \"wamid.test\",\n                \"type\": \"text\",\n                \"text\": {\n                  \"body\": \"Need visa assistance\"\n                }\n              }\n            ],\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Webhook User\"\n                }\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook/whatsapp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "whatsapp"
              ]
            }
          }
        }
      ]
    }
  ]
}