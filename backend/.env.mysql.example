# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=replace-with-32-char-secret
JWT_ACCESS_EXPIRES_IN=7d
AUTH_DEFAULT_ROLE=sales_consultant

# Database (MySQL)
DATABASE_CLIENT=mysql
# Option A
DATABASE_URL=mysql://user:password@localhost:3306/travel_crm

# Option B
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=travel_crm

# Storage (choose one stack)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=

# Azure storage if used
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
