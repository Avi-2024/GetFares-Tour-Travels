# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=replace-with-32-char-secret
JWT_ACCESS_EXPIRES_IN=7d
AUTH_DEFAULT_ROLE=sales_consultant

# Database (MySQL)
DATABASE_CLIENT=mysql
# Option A
DATABASE_URL=mysql://user:password@localhost:3306/travel_crm

# Option B
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=travel_crm

# Storage (choose one stack)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=

# Azure storage if used
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
META_VERIFY_TOKEN=replace_with_meta_verify_token
META_ACCESS_TOKEN=replace_with_meta_access_token
META_APP_SECRET=replace_with_meta_app_secret
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v20.0
META_GRAPH_FIELDS=id,created_time,field_data,ad_id,adset_id,campaign_id,form_id,page_id
META_ALLOW_INSECURE_WEBHOOKS=false

WHATSAPP_VERIFY_TOKEN=replace_with_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=replace_with_whatsapp_access_token
WHATSAPP_APP_SECRET=replace_with_whatsapp_app_secret
WHATSAPP_APP_ID=replace_with_whatsapp_app_id
WHATSAPP_PHONE_NUMBER_ID=replace_with_default_phone_number_id
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ALLOW_INSECURE_WEBHOOKS=false
