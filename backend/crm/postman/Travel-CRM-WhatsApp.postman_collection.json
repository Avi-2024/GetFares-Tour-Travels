    {
      "name": "5) Event-Driven Flow",
      "item": [
        {
          "name": "POST /api/leads (trigger leads.created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('leadId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"WhatsApp Event Test Lead\",\n  \"phone\": \"{{whatsappTo}}\",\n  \"source\": \"Postman WA Test\",\n  \"destinationName\": \"Dubai\",\n  \"travelDate\": \"2026-06-10\",\n  \"adultsCount\": 2,\n  \"childrenCount\": 0,\n  \"budget\": 200000,\n  \"visaRequired\": true,\n  \"preferredHotelCategory\": \"4_STAR\",\n  \"travelPurpose\": \"LEISURE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
