{
  "info": {
    "_postman_id": "0f7b2f2d-7f9d-4d79-90d0-19b96cb11920",
    "name": "Travel CRM - WhatsApp APIs",
    "description": "WhatsApp integration test collection: auth, config readiness, webhook verify/receive, direct sends, and event-driven lead follow-up tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1) Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}",
                  "if (json && json.data && json.data.user && json.data.user.id) {",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login first. Saves accessToken and userId in collection variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2) WhatsApp Config",
      "item": [
        {
          "name": "GET /api/whatsapp/config-status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.missing) {",
                  "  pm.collectionVariables.set('missingConfig', JSON.stringify(json.data.missing));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/config-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "config-status"
              ]
            },
            "description": "Checks if WhatsApp credentials are configured at runtime."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3) Webhook",
      "item": [
        {
          "name": "GET /webhook/whatsapp (verify)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhook/whatsapp?hub.mode=subscribe&hub.verify_token={{webhookVerifyToken}}&hub.challenge=12345",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "whatsapp"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{webhookVerifyToken}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "12345"
                }
              ]
            },
            "description": "Webhook verification handshake endpoint. Expected response body: 12345"
          },
          "response": []
        },
        {
          "name": "POST /webhook/whatsapp (simulate inbound message)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const appSecret = pm.collectionVariables.get('whatsappAppSecret');",
                  "const rawTemplate = pm.request.body && pm.request.body.raw ? pm.request.body.raw : '';",
                  "const raw = pm.variables.replaceIn(rawTemplate);",
                  "if (appSecret && raw) {",
                  "  const signature = CryptoJS.HmacSHA256(raw, appSecret).toString(CryptoJS.enc.Hex);",
                  "  pm.request.headers.upsert({ key: 'x-hub-signature-256', value: 'sha256=' + signature });",
                  "} else {",
                  "  pm.request.headers.remove('x-hub-signature-256');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"{{wabaId}}\",\n      \"changes\": [\n        {\n          \"field\": \"messages\",\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"{{displayPhoneNumber}}\",\n              \"phone_number_id\": \"{{phoneNumberId}}\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Webhook Test User\"\n                },\n                \"wa_id\": \"{{whatsappTo}}\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"{{whatsappTo}}\",\n                \"id\": \"wamid.HBgMTEST123\",\n                \"timestamp\": \"1710000000\",\n                \"type\": \"text\",\n                \"text\": {\n                  \"body\": \"Hello from webhook simulation\"\n                }\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/webhook/whatsapp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "whatsapp"
              ]
            },
            "description": "Simulates inbound WhatsApp webhook payload. If app secret is set, signature header is auto-generated in pre-request script."
          },
          "response": []
        }
      ]
    },
