{
  "name": "travel-crm-modular-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Travel CRM modular monolith with feature-based architecture.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
