    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.1",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.1",
    "pino": "^9.8.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
